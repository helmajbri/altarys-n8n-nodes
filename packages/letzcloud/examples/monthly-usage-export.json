{
  "name": "Email last month's usage as a CSV file",
  "nodes": [
    {
      "parameters": {
        "content": "## Email last month's usage as a CSV file\n\nOn the first day of each month, this workflow reads last month's usage of your LetzCloud account, writes one row per resource to a CSV file, and emails the file.\n\n### Set up\n1. Install the community package `@altarys/n8n-nodes-letzcloud`.\n2. Select a **LetzCloud API** credential with a customer key in **Get last month's usage**. Usage belongs to a customer, so a provider key is refused.\n3. Select an SMTP credential in **Email the usage file**.\n4. Change the addresses in **Settings**.\n5. Publish the workflow.\n\nIf the usage can't be read, the execution fails, so it shows as failed in the executions list.\n\nGuide: https://github.com/helmajbri/altarys-n8n-nodes/blob/main/packages/letzcloud/docs/examples.md",
        "height": 580,
        "width": 440
      },
      "id": "c2b3c4d5-0055-4000-8000-000000000056",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -460,
        -160
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "months",
              "triggerAtDayOfMonth": 1,
              "triggerAtHour": 6
            }
          ]
        }
      },
      "id": "c2b3c4d5-0057-4000-8000-000000000058",
      "name": "First day of the month",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c2b3c4d5-0059-4000-8000-00000000005a",
              "name": "toEmail",
              "value": "finance@example.com",
              "type": "string"
            },
            {
              "id": "c2b3c4d5-005b-4000-8000-00000000005c",
              "name": "fromEmail",
              "value": "n8n@example.com",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c2b3c4d5-005d-4000-8000-00000000005e",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "resource": "usage",
        "operation": "get",
        "options": {
          "period": "last_month"
        }
      },
      "id": "c2b3c4d5-005f-4000-8000-000000000060",
      "name": "Get last month's usage",
      "type": "@altarys/n8n-nodes-letzcloud.letzCloud",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "fieldToSplitOut": "resources",
        "options": {}
      },
      "id": "c2b3c4d5-0061-4000-8000-000000000062",
      "name": "One row per resource",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        680,
        -100
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c2b3c4d5-0063-4000-8000-000000000064",
              "name": "resource",
              "value": "={{ $json.name }}",
              "type": "string"
            },
            {
              "id": "c2b3c4d5-0065-4000-8000-000000000066",
              "name": "type",
              "value": "={{ $json.resource_type }}",
              "type": "string"
            },
            {
              "id": "c2b3c4d5-0067-4000-8000-000000000068",
              "name": "plan",
              "value": "={{ $json.plan }}",
              "type": "string"
            },
            {
              "id": "c2b3c4d5-0069-4000-8000-00000000006a",
              "name": "usage",
              "value": "={{ ($json.quantities || []).map(q => q.name + ': ' + q.quantity + ' ' + q.unit).join('; ') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c2b3c4d5-006b-4000-8000-00000000006c",
      "name": "Report columns",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        900,
        -100
      ]
    },
    {
      "parameters": {
        "operation": "csv",
        "options": {
          "fileName": "=usage-{{ $now.minus({ months: 1 }).toFormat('yyyy-LL') }}.csv"
        }
      },
      "id": "c2b3c4d5-006d-4000-8000-00000000006e",
      "name": "Write CSV file",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        1120,
        -100
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Settings').first().json.fromEmail }}",
        "toEmail": "={{ $('Settings').first().json.toEmail }}",
        "subject": "=LetzCloud usage for {{ $now.minus({ months: 1 }).toFormat('LLLL yyyy') }}",
        "emailFormat": "text",
        "text": "=The attached file lists last month's usage of each resource.",
        "options": {
          "fileAttachments": "data"
        }
      },
      "id": "c2b3c4d5-006f-4000-8000-000000000070",
      "name": "Email the usage file",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1340,
        -100
      ]
    },
    {
      "parameters": {
        "errorMessage": "The usage could not be read from LetzCloud. Open the failed execution to see the message from the LetzCloud node."
      },
      "id": "c2b3c4d5-0071-4000-8000-000000000072",
      "name": "Stop: usage could not be read",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        680,
        140
      ]
    }
  ],
  "connections": {
    "First day of the month": {
      "main": [
        [
          {
            "node": "Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Settings": {
      "main": [
        [
          {
            "node": "Get last month's usage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get last month's usage": {
      "main": [
        [
          {
            "node": "One row per resource",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Stop: usage could not be read",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One row per resource": {
      "main": [
        [
          {
            "node": "Report columns",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Report columns": {
      "main": [
        [
          {
            "node": "Write CSV file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write CSV file": {
      "main": [
        [
          {
            "node": "Email the usage file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
