{
  "name": "Restart stopped instances every morning",
  "nodes": [
    {
      "parameters": {
        "content": "## Restart stopped instances every morning\n\nEvery day at 7:00, this workflow finds the stopped instances whose name contains the text you set, starts each one, and waits until it runs. If an instance can't be started, it emails your team.\n\n### Set up\n1. Install the community package `@altarys/n8n-nodes-letzcloud`.\n2. Select a **LetzCloud API** credential in the three LetzCloud nodes. A provider key or a customer key works.\n3. Select an SMTP credential in **Email: instance not restarted**.\n4. In **Settings**, set the name text and the addresses.\n5. Publish the workflow.\n\nGuide: https://github.com/helmajbri/altarys-n8n-nodes/blob/main/packages/letzcloud/docs/examples.md",
        "height": 560,
        "width": 440
      },
      "id": "c1a2b3c4-003f-4000-8000-000000000040",
      "name": "Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -460,
        -140
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "c1a2b3c4-0041-4000-8000-000000000042",
      "name": "Every day at 7:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1a2b3c4-0043-4000-8000-000000000044",
              "name": "nameContains",
              "value": "web-",
              "type": "string"
            },
            {
              "id": "c1a2b3c4-0045-4000-8000-000000000046",
              "name": "toEmail",
              "value": "cloud-team@example.com",
              "type": "string"
            },
            {
              "id": "c1a2b3c4-0047-4000-8000-000000000048",
              "name": "fromEmail",
              "value": "n8n@example.com",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c1a2b3c4-0049-4000-8000-00000000004a",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "resource": "instance",
        "operation": "getAll",
        "returnAll": true,
        "filters": {
          "state": "Stopped",
          "search": "={{ $json.nameContains }}"
        }
      },
      "id": "c1a2b3c4-004b-4000-8000-00000000004c",
      "name": "Get stopped instances",
      "type": "@altarys/n8n-nodes-letzcloud.letzCloud",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "instance",
        "operation": "changeState",
        "vmId": "={{ $json.id }}",
        "stateAction": "start",
        "additionalFields": {}
      },
      "id": "c1a2b3c4-004d-4000-8000-00000000004e",
      "name": "Start instance",
      "type": "@altarys/n8n-nodes-letzcloud.letzCloud",
      "typeVersion": 1,
      "position": [
        680,
        -100
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "instance",
        "operation": "waitForState",
        "vmId": "={{ $('Get stopped instances').item.json.id }}",
        "targetState": "Running",
        "timeoutSeconds": 900,
        "intervalSeconds": 15
      },
      "id": "c1a2b3c4-004f-4000-8000-000000000050",
      "name": "Wait until running",
      "type": "@altarys/n8n-nodes-letzcloud.letzCloud",
      "typeVersion": 1,
      "position": [
        920,
        -100
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Settings').first().json.fromEmail }}",
        "toEmail": "={{ $('Settings').first().json.toEmail }}",
        "subject": "=Instance {{ $('Get stopped instances').item.json.name }} was not restarted",
        "emailFormat": "text",
        "text": "=The workflow could not start the instance {{ $('Get stopped instances').item.json.name }}, or it did not reach the Running state in time.\n\nCheck the instance in the LetzCloud console.",
        "options": {}
      },
      "id": "c1a2b3c4-0051-4000-8000-000000000052",
      "name": "Email: instance not restarted",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1160,
        60
      ]
    },
    {
      "parameters": {
        "errorMessage": "The stopped instances could not be read from LetzCloud. Open the failed execution to see the message from the LetzCloud node."
      },
      "id": "c1a2b3c4-0053-4000-8000-000000000054",
      "name": "Stop: instances could not be listed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        680,
        140
      ]
    }
  ],
  "connections": {
    "Every day at 7:00": {
      "main": [
        [
          {
            "node": "Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Settings": {
      "main": [
        [
          {
            "node": "Get stopped instances",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get stopped instances": {
      "main": [
        [
          {
            "node": "Start instance",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Stop: instances could not be listed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start instance": {
      "main": [
        [
          {
            "node": "Wait until running",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Email: instance not restarted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait until running": {
      "main": [
        [],
        [
          {
            "node": "Email: instance not restarted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
